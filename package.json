{
  "name": "mixin-patch",
  "description": "Patch the mixin problem #28799",
  "version": "1.0.0-rc.1",
  "author": "Emilio Platzer <emilioplatzer@gmail.com>",
  "license": "MIT",
  "files": [
    "dist",
    "bin"
  ],
  "bin": {
    "mixin-patch": "./bin/mixin-patch-cli.js"
  },
  "repository": "codenautas/mixin-patch",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    }
  ],
  "dependencies": {
    "best-globals": "^2.0.1",
    "cast-error": "^0.1.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "best-globals": "^2.2.2",
    "discrepances": "^0.2.14",
    "js-yaml": "^5.2.2",
    "mocha": "^12.0.0-rc.5",
    "c8": "~12.0.0",
    "qa-control": "^0.9.1",
    "source-map-support": "^0.5.21",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "main": "dist/mixin-patch.js",
  "types": "dist/mixin-patch.d.ts",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "tsc": "tsc",
    "test": "npm run prepare && mocha --reporter spec --bail --check-leaks --exit work/test/",
    "test-ci": "c8 --reporter=lcov --reporter=text-lcov mocha --exit --check-leaks work/test/*.js",
    "test-cov": "c8 mocha --exit --check-leaks work/test/*.js",
    "prepare": "tsc -p tsconfig-tool.json && tsc -p tsconfig-test.json",
    "build-without-err": "(tsc -p tsconfig-tool.json || echo \"continue w/error\") && (tsc -p tsconfig-test.json  || echo \"continue w/error\")"
  },
  "c8": {
    "extension": [
      ".js"
    ],
    "exclude": [
      "**/*.d.ts",
      "src/test"
    ],
    "include": [
      "dist/**/*.js"
    ],
    "reporter": [
      "html",
      "lcov",
      "text-summary"
    ],
    "all": true,
    "check-coverage": true
  },
  "qa-control": {
    "run-in": "server",
    "test-appveyor": true,
    "type": "lib",
    "coverage": 100,
    "gha": "all",
    "multilang": "no"
  }
}
