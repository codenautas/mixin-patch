{
    "compilerOptions": {
        "declaration": true,
        "inlineSourceMap": true,
        "inlineSources": true,
        "moduleResolution": "nodenext",
        "lib":["es2023"],
        "target": "es2023",
        "strict": true, // por ahora lo dejamos deshabilitado aunque sirve activarlo antes de pushear para ver algunos posibles errores.
        "skipLibCheck": true, //para que no haga chequeo de tipos en los declaration files dentro de node-modules(pg-promise-strict, express, node)
        "module": "nodenext",
        "types": ["node"],
        "declarationMap": true,
        "noImplicitAny": true,
        "alwaysStrict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true, /* Report error when not all code paths in function return a value. */
        "noFallthroughCasesInSwitch": true,
        "removeComments": false
    },
}
